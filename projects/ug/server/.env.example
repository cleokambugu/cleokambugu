# Copy to .env and export, or set these in the host's environment. With no FLW_SECRET_KEY the server runs in SANDBOX:
# OTP codes are returned to the client, payments confirm without a processor, documents clear after a minute.

PORT=8787
UG_DB=./data/ug.sqlite            # SQLite file; a mounted volume in Docker
UG_SANDBOX=1                      # force sandbox even with keys present
UG_DEMO_SEED=1                    # seed six stages and two drivers on an empty database
UG_CORS_ORIGIN=*                  # lock to the site's origin in production
UG_CONCIERGE=sim                  # sim | (a partner adapter name once one exists)

# Flutterwave (live payments)
FLW_PUBLIC_KEY=FLWPUBK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X
FLW_WEBHOOK_HASH=change-me        # the same secret hash you set in the Flutterwave dashboard

# SMS for one-time codes: console (sandbox) | africastalking | generic
SMS_PROVIDER=console
AT_USERNAME=
AT_API_KEY=
AT_SENDER=
SMS_URL=
SMS_AUTH=
