  "ops.button.partners": {
   "text": "Partners",
   "html": false,
   "where": "ops <button>"
  },
  "ops.p.every_town_on_the": {
   "text": "Every town on the map is a corridor from Kampala and a stage of its own. Where a local app already runs, UG hands the last mile to it rather than pretending to be there.",
   "html": false,
   "where": "ops <p>"
  },
  "ops.div.plug_ins_ug_talks": {
   "text": "Plug-ins · <b>UG talks to the tools you already use</b>",
   "html": true,
   "where": "ops <div>"
  },
  "ops.h2.maps_from_felt_climate": {
   "text": "Maps from Felt. Climate workflows from Infrared City. Entertainment from Tazama. Hands-free control from Cephable.",
   "html": false,
   "where": "ops <h2>"
  },
  "ops.p.each_plug_in_is": {
   "text": "Each plug-in is an adapter with its own endpoint and key, stored on this device until you sign in. Connect one and the matching buttons light up across Pool, Explore and Hustle Mode. Nothing leaves UG without a plug-in you switched on.",
   "html": false,
   "where": "ops <p>"
  },
  "ops.div.partners_we_send_you": {
   "text": "Partners · <b>we send you demand</b>",
   "html": true,
   "where": "ops <div>"
  },
  "ops.h2.competitors_are_listed_on": {
   "text": "Competitors are listed on purpose. A rider who trusts the comparison comes back for the pool and the rental.",
   "html": false,
   "where": "ops <h2>"
  },
  "ops.p.ug_is_a_marketplace": {
   "text": "UG is a marketplace first. Ride-hailing apps get pre-filled bookings with no acquisition cost. Rental yards get vetted weekend renters. Lodges get groups arriving on a known date. Drivers get a route full before they leave.",
   "html": false,
   "where": "ops <p>"
  },
  "ops.h3.for_riders": {
   "text": "For riders",
   "html": false,
   "where": "ops <h3>"
  },
  "ops.p.verified_drivers_and_plates": {
   "text": "Verified drivers and plates, an in-trip SOS that shares live location with a contact you choose, helmets on every pooled boda, and a receipt for every shilling.",
   "html": false,
   "where": "ops <p>"
  },
  "ops.h3.for_drivers_and_yards": {
   "text": "For drivers and yards",
   "html": false,
   "where": "ops <h3>"
  },
  "ops.p.ten_percent_on_pool": {
   "text": "Ten percent on pool, a flat listing fee on rentals, weekly payouts to MoMo through Flutterwave, and demand you did not have to advertise for.",
   "html": false,
   "where": "ops <p>"
  },
  "ops.h3.for_the_apps_we": {
   "text": "For the apps we compare",
   "html": false,
   "where": "ops <h3>"
  },
  "ops.p.deep_links_that_open": {
   "text": "Deep links that open your app with pick-up and drop-off filled. We never show a price we did not compute openly, and the method is published.",
   "html": false,
   "where": "ops <p>"
  },
